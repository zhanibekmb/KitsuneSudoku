{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with their stats, points, and inventory",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "isPro": { "type": "boolean" },
        "points": { "type": "number" },
        "coins": { "type": "number" },
        "streak": { "type": "number" },
        "lastLoginDate": { "type": "string" },
        "inventory": { "type": "array", "items": { "type": "string" } },
        "activeTitle": { "type": "string" },
        "activeAvatar": { "type": "string" },
        "statsPlayed": { "type": "number" },
        "statsWon": { "type": "number" },
        "theme": { "type": "string" }
      },
      "required": ["uid", "name", "city", "isPro", "points", "coins", "streak", "statsPlayed", "statsWon", "theme"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Public and private user stats, used for leaderboards. The profile update is restricted to the owner."
    }
  }
}
